# Local development overrides. Every value has a working default; copy to .env only to change something.

# API
# PORT=4000
# DATABASE_URL=postgres://buildwise:buildwise@localhost:5432/buildwise   # unset = embedded PGlite under DATA_DIR
# DATA_DIR=/absolute/path               # development data; default is .buildwise/dev in your home folder
# MARKET_PACK=demo-2026.1
# EXPOSE_OTP=true                    # development only: show sign-in codes on the page
# OTP_LIMIT_PER_HOUR=1000            # development/tests only: relax code limits for automated tests
# RATE_LIMIT_PER_MINUTE=600
# RUN_WORKER_IN_PROCESS=true
# PUBLIC_WEB_URL=http://localhost:3000
# PUBLIC_SUPPORT_EMAIL=support@buildwise.example   # web: support address on the contact and legal pages (placeholder default)
# AUTH_SECRET=dev-only-auth-secret-change-me-0123456789abcdef
# INTERNAL_API_SECRET=dev-only-internal-secret
# CHECKOUT_WEBHOOK_SECRET=dev-only-checkout-webhook-secret
# RATE_LIMIT_STORE=memory            # postgres when deployed

# Providers (see README "Providers"). Unset = development stand-ins.
# ASSISTANT_PER_MINUTE=30            # build assistant messages per IP per minute
# BUILDER_AI_PROVIDER=gemini         # Gemini reasoning and read-only tools, local fallback
# ASSISTANT_PROVIDER=gemini          # Optional Gemini interpretation and teacher labels
# PAID_AI=off                        # Reject paid provider configurations at startup
# BUILDER_AI_MODEL=gemini-3.8-flash,gemini-3.6-flash
# BUILDER_AI_PER_MINUTE=8
# BUILDER_AI_DAILY_LIMIT=2000
# ARCHITECT_PROVIDER=gemini          # gemini | anthropic | none: AI review and ranking (none = engine notes)
# ANTHROPIC_API_KEY=
# ARCHITECT_MODEL=claude-opus-5-5
# ARCHITECT_PER_MINUTE=3             # fresh AI reviews per IP per minute (cached reviews are free)
# ARCHITECT_DAILY_LIMIT=300          # fresh AI reviews per day, across all visitors
# RENDER_PROVIDER=openai             # openai | none: photoreal render of the 3D model (none = no render button)
# OPENAI_API_KEY=
# RENDER_MODEL=gpt-image-1.5
# RENDER_PER_MINUTE=2                # renders per IP per minute
# RENDER_DAILY_LIMIT=100             # renders per day, across all visitors
# DESIGNER_PROVIDER=gemini           # gemini | anthropic | none, or a provider chain: composes the building
# DESIGNER_CLAUDE_MODEL=claude-opus-5-5
# GEMINI_API_KEY=                    # Use a Google AI Studio Free Tier project
# DESIGNER_MODEL=gemini-3.6-flash,gemini-3.8-flash  # tried in order when one is busy
# DESIGNER_PER_MINUTE=3              # AI designs per IP per minute
# DESIGNER_DAILY_LIMIT=200           # AI designs per day, across all visitors
# DREAM_PROVIDER=gemini              # gemini | openai | none: AI-painted impressions of the design (none = no gallery); Claude checks them when ARCHITECT_PROVIDER=anthropic
# DREAM_MODEL=gemini-nano-banana-2.1,gemini-3.1-flash-image,gemini-3.1-flash-lite-image   # tried in order when one is busy (openai default: gpt-image-1.5); Gemini image models need a paid tier
# DREAM_PER_MINUTE=4                 # dream renders per IP per minute
# DREAM_DAILY_LIMIT=200              # dream renders per day, across all visitors
# SMS_PROVIDER=termii                # termii | twilio | none
# TERMII_API_KEY=
# TERMII_SENDER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# EMAIL_PROVIDER=resend              # resend | none
# RESEND_API_KEY=
# EMAIL_FROM=BuildWise <no-reply@your-domain>
# PAYMENT_PROVIDER=paystack          # paystack | dev
# PAYSTACK_SECRET_KEY=
# RECEIPT_EMAIL_DOMAIN=

# Web
# API_URL=http://localhost:4000

# Worldwide design references. Set an Exa API key on the API server to enable them.
# EXA_API_KEY=

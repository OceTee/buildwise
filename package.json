{
  "name": "buildwise",
  "private": true,
  "version": "0.1.0",
  "description": "Construction marketplace website (Release 1) growing into the full construction platform",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @bw/api --filter @bw/web dev",
    "seed": "pnpm --filter @bw/api seed",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "e2e": "pnpm --filter @bw/e2e e2e"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}

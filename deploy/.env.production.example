# Copy to deploy/.env.production (git-ignored) and fill in. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
AUTH_SECRET=
INTERNAL_API_SECRET=
CHECKOUT_WEBHOOK_SECRET=
PUBLIC_WEB_URL=https://www.example.com
MARKET_PACK=demo-2026.1

# Providers: production needs SMS and a live payment key (see README "Providers")
SMS_PROVIDER=
TERMII_API_KEY=
TERMII_SENDER_ID=
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=

# Optional AI architect for the build flow (see README "Providers"); leave unset for the design engine's own notes
BUILDER_AI_PROVIDER=
ARCHITECT_PROVIDER=
ANTHROPIC_API_KEY=

# Optional photoreal render of the 3D model (OpenAI image model); leave unset for no render button
RENDER_PROVIDER=
OPENAI_API_KEY=
# Optional AI designer (Gemini) that composes massing and rooms; leave unset for BuildWise's own engine
DESIGNER_PROVIDER=
GEMINI_API_KEY=

{
  "name": "@bw/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker-main.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bw/domain": "workspace:*",
    "@electric-sql/pglite": "^0.5.16",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
